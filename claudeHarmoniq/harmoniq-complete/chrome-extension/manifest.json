{
  "manifest_version": 3,
  "name": "Harmoniq",
  "version": "5.0.0",
  "description": "Mood-based playlist generator for your emotional journey",
  "action": {
    "default_popup": "popup-v2.html",
    "default_title": "Harmoniq"
  },
  "permissions": ["storage", "activeTab", "tabs", "identity", "clipboardWrite"],
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://api.spotify.com/*",
    "https://accounts.spotify.com/*",
    "https://*.firebaseapp.com/*",
    "https://*.googleapis.com/*",
    "https://www.gstatic.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "web_accessible_resources": [{
    "resources": ["setupWizard.html", "instructions.html", "auth.html"],
    "matches": ["<all_urls>"]
  }]
}
